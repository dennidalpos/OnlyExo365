<UserControl x:Class="ExchangeAdmin.Presentation.Views.ComplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
             xmlns:controls="clr-namespace:ExchangeAdmin.Presentation.Controls">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Key=Compliance.Title}"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource ErrorBannerBorderStyle}"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding Compliance.HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Compliance.ErrorMessage}"
                               Style="{StaticResource ErrorBannerTextStyle}"/>
                </Border>

                <Border Style="{StaticResource WarningBannerBorderStyle}"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding Compliance.HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Compliance.WarningsText}"
                                   Style="{StaticResource WarningBannerTextStyle}"/>
                        <TextBlock Text="{Binding Compliance.DiagnosticReferenceText}"
                                   Style="{StaticResource StatusBannerDetailTextStyle}"
                                   Visibility="{Binding Compliance.HasDiagnosticReference, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoBannerBorderStyle}"
                        Padding="8"
                        Margin="0,0,0,8"
                        Visibility="{Binding Compliance.HasHoldListingStatus, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Compliance.HoldListingStatusMessage}"
                                   Style="{StaticResource InfoBannerTextStyle}"/>
                        <TextBlock Text="{loc:Loc Key=Compliance.HoldCmdletWarning}"
                                   Style="{StaticResource StatusBannerDetailTextStyle}"/>
                    </StackPanel>
                </Border>

                <controls:SectionPanel Header="{loc:Loc Key=Compliance.AuditLogGroup}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.StartDate}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <DatePicker SelectedDate="{Binding Compliance.AuditStartDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.EndDate}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <DatePicker SelectedDate="{Binding Compliance.AuditEndDate}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.UserIds}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding Compliance.AuditUserIdsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.Operations}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding Compliance.AuditOperationsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.ObjectIds}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding Compliance.AuditObjectIdsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.FreeText}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding Compliance.AuditFreeText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                                <TextBlock Text="{loc:Loc Key=Compliance.MaxResults}" Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBox Text="{Binding Compliance.AuditMaxResults, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                                <Button Content="{loc:Loc Key=Compliance.QueueSearchBtn}"
                                        Command="{Binding Compliance.SearchAuditLogCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="{Binding Compliance.AuditStatusText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Compliance.AuditTaskCenterStatus}"
                                   Margin="0,0,0,8"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <DataGrid ItemsSource="{Binding Compliance.AuditSearchTasks}"
                                  SelectedItem="{Binding Compliance.SelectedAuditSearchTask}"
                                  AutoGenerateColumns="False"
                                  MinHeight="140"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColTask}" Binding="{Binding Title}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColStatus}" Binding="{Binding StateLabel}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColProgress}" Binding="{Binding ProgressText}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColRecords}" Binding="{Binding ResultCount}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColRequested}" Binding="{Binding RequestedAtDisplay}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColFilters}" Binding="{Binding FilterSummary}" Width="Auto" MinWidth="240"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource ErrorBannerBorderStyle}"
                                Padding="8"
                                Margin="0,0,0,8"
                                Visibility="{Binding Compliance.HasAuditError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Compliance.AuditErrorMessage}"
                                           Style="{StaticResource ErrorBannerTextStyle}"/>
                                <TextBlock Text="{Binding Compliance.SelectedAuditTaskReferenceText}"
                                           Style="{StaticResource StatusBannerDetailTextStyle}"
                                           Visibility="{Binding Compliance.HasSelectedAuditTaskReference, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WarningBannerBorderStyle}"
                                Padding="8"
                                Margin="0,0,0,8"
                                Visibility="{Binding Compliance.HasAuditWarning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Compliance.AuditWarning}"
                                           Style="{StaticResource WarningBannerTextStyle}"/>
                                <TextBlock Text="{Binding Compliance.SelectedAuditTaskReferenceText}"
                                           Style="{StaticResource StatusBannerDetailTextStyle}"
                                           Visibility="{Binding Compliance.HasSelectedAuditTaskReference, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding Compliance.HasSelectedAuditSearchTask, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Compliance.SelectedAuditTaskStatusMessage}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Compliance.SelectedAuditTaskFilterSummary}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Compliance.AuditResults}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColDate}" Binding="{Binding CreationDate}" Width="Auto" MinWidth="160"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColUser}" Binding="{Binding UserIds}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColOperation}" Binding="{Binding Operations}" Width="Auto" MinWidth="160"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColObject}" Binding="{Binding ObjectId}" Width="Auto" MinWidth="220"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColStatus}" Binding="{Binding ResultStatus}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColRecordType}" Binding="{Binding RecordType}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="{loc:Loc Key=Compliance.AuditColAuditData}" Binding="{Binding AuditData}" Width="Auto" MinWidth="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </controls:SectionPanel>

                <controls:SectionPanel Header="{loc:Loc Key=Compliance.SearchGroup}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="{loc:Loc Key=Compliance.RefreshWorkspaceBtn}"
                                        Command="{Binding Compliance.RefreshWorkspaceCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="{Binding Compliance.SearchesStatusText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Compliance.Searches}"
                                      SelectedItem="{Binding Compliance.SelectedSearch}"
                                      AutoGenerateColumns="False"
                                      MinHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColName}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColCase}" Binding="{Binding CaseName}" Width="Auto" MinWidth="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColStatus}" Binding="{Binding Status}" Width="Auto" MinWidth="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColLocations}" Binding="{Binding ExchangeLocations.Count}" Width="Auto" MinWidth="90"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColQuery}" Binding="{Binding ContentMatchQuery}" Width="Auto" MinWidth="240"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Loc Key=Compliance.SelectedSearchDetails}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{loc:Loc Key=Compliance.Locations}"/>
                                    <TextBlock Text="{Binding Compliance.SelectedSearchExchangeLocations, Mode=OneWay}"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Compliance.SelectedSearchQuery, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=Compliance.NewSearchHeading}" FontWeight="SemiBold"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldName}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding Compliance.CreateSearchName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldCase}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding Compliance.CreateSearchCaseName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldExchangeLocations}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding Compliance.CreateExchangeLocationsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     TextWrapping="Wrap"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldContentQuery}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding Compliance.CreateContentMatchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     TextWrapping="Wrap"/>

                            <Button Content="{loc:Loc Key=Compliance.CreateSearchBtn}"
                                    Command="{Binding Compliance.CreateSearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>

                            <Separator Margin="0,12,0,12"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.SelectedActionsHeading}" FontWeight="SemiBold"/>

                            <Button Content="{loc:Loc Key=Compliance.StartSearchBtn}"
                                    Command="{Binding Compliance.StartSearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,8,0,0"/>
                            <Button Content="{loc:Loc Key=Compliance.RemoveSearchBtn}"
                                    Command="{Binding Compliance.RemoveSearchCommand}"
                                    Style="{StaticResource DangerButton}"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldPurgeType}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding Compliance.PurgeTypes}"
                                      SelectedItem="{Binding Compliance.SelectedPurgeType}"/>
                            <Button Content="{loc:Loc Key=Compliance.RunPurgeBtn}"
                                    Command="{Binding Compliance.PurgeSearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,8,0,0"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldCaseForHold}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <ComboBox ItemsSource="{Binding Compliance.Cases}"
                                      SelectedItem="{Binding Compliance.SelectedCase}"
                                      DisplayMemberPath="Name"/>

                            <TextBlock Text="{loc:Loc Key=Compliance.FieldHoldName}" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding Compliance.HoldName, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Content="{loc:Loc Key=Compliance.CreateHoldBtn}"
                                    Command="{Binding Compliance.HoldSearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </controls:SectionPanel>

                <controls:SectionPanel Header="{loc:Loc Key=Compliance.CasesActionsGroup}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Compliance.CasesStatusText}"
                                       Margin="0,0,0,8"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <DataGrid ItemsSource="{Binding Compliance.Cases}"
                                      SelectedItem="{Binding Compliance.SelectedCase}"
                                      AutoGenerateColumns="False"
                                      MinHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColName}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColStatus}" Binding="{Binding Status}" Width="Auto" MinWidth="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColType}" Binding="{Binding CaseType}" Width="Auto" MinWidth="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Compliance.ActionsStatusText}"
                                       Margin="0,0,0,8"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <DataGrid ItemsSource="{Binding Compliance.Actions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MinHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColName}" Binding="{Binding Name}" Width="Auto" MinWidth="170"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColActionType}" Binding="{Binding ActionType}" Width="Auto" MinWidth="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColSearch}" Binding="{Binding SearchName}" Width="Auto" MinWidth="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColCase}" Binding="{Binding CaseName}" Width="Auto" MinWidth="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColStatus}" Binding="{Binding Status}" Width="Auto" MinWidth="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColCreated}" Binding="{Binding CreatedTime}" Width="Auto" MinWidth="160"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=Compliance.ColDetails}" Binding="{Binding Details}" Width="Auto" MinWidth="240"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </controls:SectionPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                Visibility="{Binding Compliance.IsLoadingOverlayVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Compliance.LoadingOverlayText}"
                               Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
