<UserControl x:Class="ExchangeAdmin.Presentation.Views.MailboxListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ExchangeAdmin.Presentation.Helpers"
             xmlns:views="clr-namespace:ExchangeAdmin.Presentation.Views"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
             xmlns:controls="clr-namespace:ExchangeAdmin.Presentation.Controls">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Key=Mailbox.List.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding Mailboxes.StatusText}"
                           Visibility="{Binding Mailboxes.IsMailboxInventoryWorkspace, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding Mailboxes.Provisioning.StatusText}"
                           Visibility="{Binding Mailboxes.IsProvisioningWorkspace, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Key=Mailbox.List.ExchangeInventoryHeading}"
                        Command="{Binding Mailboxes.ShowMailboxInventoryCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionGroupPrimaryButton}">
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mailboxes.IsMailboxInventoryWorkspace}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{loc:Loc Key=Mailbox.List.UnlicensedMembersHeading}"
                        Command="{Binding Mailboxes.ShowProvisioningWorkspaceCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ActionGroupPrimaryButton}">
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mailboxes.IsProvisioningWorkspace}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Visibility="{Binding Mailboxes.IsMailboxInventoryWorkspace, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{loc:Loc Key=Mailbox.List.ExchangeInventoryHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{loc:Loc Key=Btn.Refresh}" Command="{Binding Mailboxes.RefreshCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Content="{loc:Loc Key=Btn.Cancel}" Command="{Binding Mailboxes.CancelCommand}"
                                Style="{StaticResource DangerButton}"
                                Visibility="{Binding Mailboxes.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource InsetPanelBorderStyle}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsExchangeConnected, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{loc:Loc Key=Mailbox.List.InventoryDisconnectedMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="2"
                      Margin="0,0,0,12"
                      IsEnabled="{Binding IsExchangeConnected}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding Mailboxes.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Tag" Value="{loc:Loc Key=Mailbox.List.SearchPlaceholder}"/>
                                <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Mailbox.List.SearchLabel}"/>
                                <Setter Property="ToolTip" Value="{loc:Loc Key=Mailbox.List.SearchLabel}"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <ComboBox Grid.Column="1" Width="150" SelectedValue="{Binding Mailboxes.RecipientTypeFilter}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="{loc:Loc Key=Mailbox.List.FilterUserMailboxes}" Tag="UserMailbox"/>
                        <ComboBoxItem Content="{loc:Loc Key=Mailbox.List.FilterSharedMailboxes}" Tag="SharedMailbox"/>
                        <ComboBoxItem Content="{loc:Loc Key=Mailbox.List.FilterRoomMailboxes}" Tag="RoomMailbox"/>
                        <ComboBoxItem Content="{loc:Loc Key=Mailbox.List.FilterEquipment}" Tag="EquipmentMailbox"/>
                        <ComboBoxItem Content="{loc:Loc Key=Mailbox.List.FilterAllTypes}" Tag=""/>
                    </ComboBox>
                </Grid>

                <controls:SectionPanel Grid.Row="3"
                                       Header="{Binding Mailboxes.CreateMailboxSectionTitle}"
                                       Margin="0,0,0,12"
                                       IsEnabled="{Binding IsExchangeConnected}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Mailbox.List.CreateFormDisplayName}" Margin="0,0,8,6" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=Mailbox.List.CreateFormAlias}" Margin="0,0,8,6" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Key=Mailbox.List.CreateFormEmailLocalPart}" Margin="0,0,8,6" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Mailboxes.NewMailboxDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 AutomationProperties.Name="{loc:Loc Key=Mailbox.List.CreateFormDisplayName}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Tag" Value="e.g. Milan Helpdesk"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Mailboxes.NewMailboxAlias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 AutomationProperties.Name="{loc:Loc Key=Mailbox.List.CreateFormAlias}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Tag" Value="e.g. helpdesk.milan"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Mailboxes.NewMailboxLocalPart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 AutomationProperties.Name="{loc:Loc Key=Mailbox.List.CreateFormEmailLocalPart}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Tag" Value="e.g. helpdesk.milan"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Row="1" Grid.Column="3" Content="{loc:Loc Key=Btn.Create}" Command="{Binding Mailboxes.CreateMailboxCommand}" Style="{StaticResource PrimaryButton}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Mailbox.List.CreateFormEmailDomain}" Margin="0,8,8,6" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                        <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Mailboxes.AvailableMailDomains}"
                                  SelectedItem="{Binding Mailboxes.SelectedMailboxDomain}"
                                  Margin="0,0,8,0"
                                  AutomationProperties.Name="{loc:Loc Key=Mailbox.List.CreateFormEmailDomain}"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Loc Key=Mailbox.List.CreateFormPassword}" Margin="0,8,8,6" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Visibility="{Binding Mailboxes.IsUserMailboxCreation, Converter={StaticResource BoolToVisibility}}"/>
                        <PasswordBox Grid.Row="3" Grid.Column="2"
                                     Margin="0,0,8,0"
                                     AutomationProperties.Name="{loc:Loc Key=Mailbox.List.CreateFormPassword}"
                                     ToolTip="{loc:Loc Key=Mailbox.List.CreateFormPasswordTooltip}"
                                     PasswordChanged="NewMailboxPasswordBox_OnPasswordChanged"
                                     helpers:PasswordBoxClearHelper.ClearTrigger="{Binding Mailboxes.NewMailboxPasswordClearTrigger}"
                                     Visibility="{Binding Mailboxes.IsUserMailboxCreation, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{loc:Loc Key=Mailbox.List.WillCreateFormat}" TextWrapping="Wrap"/>
                    </Grid>
                </controls:SectionPanel>

                <Grid Grid.Row="4"
                      IsEnabled="{Binding IsExchangeConnected}">
                    <DataGrid ItemsSource="{Binding Mailboxes.Mailboxes}"
                              SelectedItem="{Binding Mailboxes.SelectedMailbox}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowBackground="{StaticResource SecondaryBackgroundBrush}"
                              AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              ScrollViewer.IsDeferredScrollingEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColDisplayName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColUPN}" Binding="{Binding UserPrincipalName, TargetNullValue=—, FallbackValue=—}" Width="Auto" MinWidth="220"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColEmail}" Binding="{Binding PrimarySmtpAddress}" Width="Auto" MinWidth="220"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColType}" Binding="{Binding RecipientTypeDetails}" Width="120"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColAlias}" Binding="{Binding Alias}" Width="Auto" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                            Visibility="{Binding Mailboxes.IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Mailboxes.LoadProgress.Status}"
                                           Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                                <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                             Value="{Binding Mailboxes.LoadProgress.Progress, Mode=OneWay}"/>
                                <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                                    <TextBlock Text="{Binding Mailboxes.LoadProgress.PercentText}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Mailboxes.LoadProgress.CountText}"
                                               Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                               Visibility="{Binding Mailboxes.LoadProgress.HasCount, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                            Visibility="{Binding Mailboxes.HasError, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource CompactErrorOverlayCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Mailbox.List.ErrorTitle}" Style="{StaticResource CompactErrorOverlayTitleTextStyle}"/>
                                <TextBlock Text="{Binding Mailboxes.ErrorMessage}" Style="{StaticResource CompactErrorOverlayMessageTextStyle}" MaxWidth="400"/>
                                <Button Content="{loc:Loc Key=Btn.Retry}" Command="{Binding Mailboxes.RefreshCommand}" Margin="0,12,0,0"
                                        Style="{StaticResource InlinePrimaryActionButton}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="{loc:Loc Key=Btn.LoadMore}" Command="{Binding Mailboxes.LoadMoreCommand}"
                            Style="{StaticResource InlineActionButton}"
                            Visibility="{Binding Mailboxes.HasMore, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource InsetPanelBorderStyle}"
                        Visibility="{Binding MailboxDetails.HasDetails, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <TextBlock Text="{loc:Loc Key=Mailbox.List.DetailsEmptyState}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <views:MailboxDetailsView DataContext="{Binding MailboxDetails}"
                                          Visibility="{Binding MailboxDetails.HasDetails, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Visibility="{Binding Mailboxes.IsProvisioningWorkspace, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" IsEnabled="{Binding Mailboxes.Provisioning.IsLoading, Converter={StaticResource InverseBool}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Mailbox.List.UnlicensedMembersHeading}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{loc:Loc Key=Mailbox.List.UnlicensedMembersDescription}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Refresh}"
                            Command="{Binding Mailboxes.Provisioning.RefreshCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Mailboxes.Provisioning.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Tag" Value="{loc:Loc Key=Mailbox.List.MemberSearchPlaceholder}"/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <CheckBox Grid.Column="1"
                              Content="{loc:Loc Key=Mailbox.List.OnlyWithoutLicenses}"
                              IsChecked="{Binding Mailboxes.Provisioning.OnlyWithoutLicense}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"/>

                    <CheckBox Grid.Column="2"
                              Content="{loc:Loc Key=Mailbox.List.OnlyWithoutMail}"
                              IsChecked="{Binding Mailboxes.Provisioning.OnlyWithoutMail}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource InsetPanelBorderStyle}"
                        Margin="0,0,0,12">
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="{loc:Loc Key=Mailbox.List.LicensingPanelInstructions}"/>
                </Border>

                <Grid Grid.Row="3">
                    <DataGrid ItemsSource="{Binding Mailboxes.Provisioning.Candidates}"
                              SelectedItem="{Binding Mailboxes.Provisioning.SelectedCandidate}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowBackground="{StaticResource SecondaryBackgroundBrush}"
                              AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColDisplayName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColUPN}" Binding="{Binding UserPrincipalName}" Width="Auto" MinWidth="220"/>
                            <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColEmail}" Binding="{Binding Mail, TargetNullValue=—, FallbackValue=—}" Width="Auto" MinWidth="220"/>
                            <DataGridCheckBoxColumn Header="{loc:Loc Key=Mailbox.List.ColEnabled}" Binding="{Binding AccountEnabled}" Width="95" MinWidth="95"/>
                            <DataGridCheckBoxColumn Header="{loc:Loc Key=Mailbox.List.ColLicensed}" Binding="{Binding HasAssignedLicense}" Width="95" MinWidth="95"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                            Visibility="{Binding Mailboxes.Provisioning.IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Mailboxes.Provisioning.LoadProgress.Status}"
                                           Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                                <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                             Value="{Binding Mailboxes.Provisioning.LoadProgress.Progress, Mode=OneWay}"/>
                                <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                                    <TextBlock Text="{Binding Mailboxes.Provisioning.LoadProgress.PercentText}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Mailboxes.Provisioning.LoadProgress.CountText}"
                                               Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                               Visibility="{Binding Mailboxes.Provisioning.LoadProgress.HasCount, Converter={StaticResource BoolToVisibility}}"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                            Visibility="{Binding Mailboxes.Provisioning.HasError, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource CompactErrorOverlayCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Mailbox.List.ErrorTitle}" Style="{StaticResource CompactErrorOverlayTitleTextStyle}"/>
                                <TextBlock Text="{Binding Mailboxes.Provisioning.ErrorMessage}" Style="{StaticResource CompactErrorOverlayMessageTextStyle}" MaxWidth="420"/>
                                <Button Content="{loc:Loc Key=Btn.Retry}"
                                        Command="{Binding Mailboxes.Provisioning.RefreshCommand}"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource InlinePrimaryActionButton}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="{loc:Loc Key=Btn.LoadMore}"
                            Command="{Binding Mailboxes.Provisioning.LoadMoreCommand}"
                            Style="{StaticResource InlineActionButton}"
                            Visibility="{Binding Mailboxes.Provisioning.HasMore, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2"
                    Style="{StaticResource SectionCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{loc:Loc Key=Mailbox.List.LicensingPanelHeading}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>

                    <StackPanel Grid.Row="1" Margin="0,12,0,12">
                        <TextBlock Text="{Binding Mailboxes.Provisioning.SelectedCandidateSummary}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding Mailboxes.Provisioning.SelectedCandidate.Mail, TargetNullValue={loc:Loc Key=Mailbox.List.MailNotSet}, FallbackValue={loc:Loc Key=Mailbox.List.MailNotSet}}"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource InsetPanelBorderStyle}"
                            Visibility="{Binding Mailboxes.Provisioning.HasSelectedCandidate, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{loc:Loc Key=Mailbox.List.LicensingPanelEmptyState}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <views:MailboxLicensesTab Grid.Row="2"
                                              DataContext="{Binding Mailboxes.Provisioning}"
                                              Visibility="{Binding Mailboxes.Provisioning.HasSelectedCandidate, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
