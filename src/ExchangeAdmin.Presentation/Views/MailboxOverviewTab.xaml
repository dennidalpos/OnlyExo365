<UserControl x:Class="ExchangeAdmin.Presentation.Views.MailboxOverviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
             xmlns:controls="clr-namespace:ExchangeAdmin.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <controls:SectionPanel Header="{loc:Loc Key=Mailbox.Overview.BasicInformation}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.DisplayName}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.PrimaryEmail}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrimarySmtpAddress}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.Type}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecipientTypeDetails}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.Alias}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.Alias}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.AllAddresses}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Details.EmailAddresses}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </controls:SectionPanel>

            <controls:SectionPanel Header="{loc:Loc Key=Mailbox.Overview.Actions}" Margin="0,0,0,12"
                      Visibility="{Binding HasConversionActions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Button Content="{loc:Loc Key=Mailbox.Overview.ConvertToShared}"
                            Command="{Binding ConvertToSharedMailboxCommand}"
                            Style="{StaticResource DangerButton}"
                            ToolTip="{loc:Loc Key=Mailbox.Overview.ConvertToSharedTooltip}"
                            Visibility="{Binding CanConvertToSharedMailbox, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.AdminInterventionWarning}"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"
                               Visibility="{Binding CanConvertToSharedMailbox, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Content="{loc:Loc Key=Mailbox.Overview.RestoreUserMailbox}"
                            Command="{Binding ConvertToRegularMailboxCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            ToolTip="{loc:Loc Key=Mailbox.Overview.RestoreUserMailboxTooltip}"
                            Visibility="{Binding CanConvertToRegularMailbox, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.RestoreDurationHint}"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"
                               Visibility="{Binding CanConvertToRegularMailbox, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </controls:SectionPanel>

            <controls:SectionPanel Header="{loc:Loc Key=Mailbox.Overview.Statistics}" Margin="0,0,0,12"
                      Visibility="{Binding Statistics, Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.TotalSize}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.TotalItemSize}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.ItemCount}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.ItemCount}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.DeletedItems}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Statistics.DeletedItemCount, StringFormat='{}{0} items'}"/>
                        <TextBlock Text="{Binding Statistics.TotalDeletedItemSize}" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Mailbox.Overview.LastAccess}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="{Binding Statistics.LastLogonTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                               Margin="0,8,0,0"/>
                </Grid>
            </controls:SectionPanel>

            <controls:SectionPanel Header="{loc:Loc Key=Mailbox.Overview.InboxRules}" Margin="0,0,0,12"
                      Visibility="{Binding InboxRules, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.NoRulesConfigured}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,8"
                               Visibility="{Binding InboxRules.Count, Converter={StaticResource ZeroToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding InboxRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Loc Key=Mailbox.Overview.RuleEnabled}" Foreground="{StaticResource SuccessBrush}" Margin="8,0,0,0"
                                                       Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{loc:Loc Key=Mailbox.Overview.RuleDisabled}" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0"
                                                       Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                        <StackPanel>
                                            <Border Style="{StaticResource WarningBannerBorderStyle}" Padding="8" Margin="0,4,0,0"
                                                    Visibility="{Binding ForwardTo, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.ForwardingRuleDetected}" Style="{StaticResource WarningBannerTextStyle}" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding ForwardTo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.ForwardsTo}" Style="{StaticResource WarningBannerTextStyle}"/>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource WarningBannerTextStyle}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource WarningBannerBorderStyle}" Padding="8" Margin="0,4,0,0"
                                                    Visibility="{Binding RedirectTo, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.RedirectRuleDetected}" Style="{StaticResource WarningBannerTextStyle}" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding RedirectTo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <TextBlock Text="{loc:Loc Key=Mailbox.Overview.RedirectsTo}" Style="{StaticResource WarningBannerTextStyle}"/>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource WarningBannerTextStyle}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:SectionPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
