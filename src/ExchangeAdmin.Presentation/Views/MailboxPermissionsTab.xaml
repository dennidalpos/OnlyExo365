<UserControl x:Class="ExchangeAdmin.Presentation.Views.MailboxPermissionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:ExchangeAdmin.Contracts.Dtos;assembly=ExchangeAdmin.Contracts"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
             xmlns:controls="clr-namespace:ExchangeAdmin.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <controls:SectionPanel Header="{loc:Loc Key=MailboxPerms.ManagementHeading}" Margin="0,0,0,12">
                <StackPanel>
                    <Border Style="{StaticResource InsetPanelBorderStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=MailboxPerms.FieldUser}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=MailboxPerms.FieldPermissionType}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Key=MailboxPerms.FieldAutoMap}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,4"/>

                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding NewPermissionUser, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"
                                     ToolTip="{loc:Loc Key=MailboxPerms.UserTooltip}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      SelectedValue="{Binding NewPermissionType}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,8,0"
                                      ToolTip="{loc:Loc Key=MailboxPerms.PermissionTypeTooltip}">
                                <ComboBoxItem Content="{loc:Loc Key=MailboxPerms.PermissionFullAccess}" Tag="{x:Static contracts:PermissionType.FullAccess}"/>
                                <ComboBoxItem Content="{loc:Loc Key=MailboxPerms.PermissionSendAs}" Tag="{x:Static contracts:PermissionType.SendAs}"/>
                                <ComboBoxItem Content="{loc:Loc Key=MailboxPerms.PermissionSendOnBehalf}" Tag="{x:Static contracts:PermissionType.SendOnBehalf}"/>
                            </ComboBox>
                            <ComboBox Grid.Row="1" Grid.Column="2"
                                      SelectedValue="{Binding NewPermissionAutoMapping}"
                                      SelectedValuePath="Tag"
                                      Margin="0,0,8,0"
                                      Width="80"
                                      ToolTip="{loc:Loc Key=MailboxPerms.AutoMapTooltipFullAccess}">
                                <ComboBoxItem Content="{loc:Loc Key=Common.True}" Tag="True"/>
                                <ComboBoxItem Content="{loc:Loc Key=Common.False}" Tag="False"/>
                            </ComboBox>
                            <Button Grid.Row="1" Grid.Column="3" Content="{loc:Loc Key=MailboxPerms.BtnAdd}"
                                    Command="{Binding AddPermissionCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="{loc:Loc Key=MailboxPerms.AddPermissionTooltip}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc Key=MailboxPerms.FullAccessHeading}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DataGrid ItemsSource="{Binding FullAccessPermissions}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              MaxHeight="200" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColUser}" Binding="{Binding User}" Width="Auto" MinWidth="220"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColAutoMap}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding AutoMapping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  Width="75"
                                                  ToolTip="{loc:Loc Key=MailboxPerms.AutoMapTooltip}">
                                            <ComboBoxItem Content="{loc:Loc Key=Common.True}" Tag="True"/>
                                            <ComboBoxItem Content="{loc:Loc Key=Common.False}" Tag="False"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColInherited}" Binding="{Binding IsInherited}" Width="80"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColActions}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{loc:Loc Key=MailboxPerms.BtnApply}"
                                                    Command="{Binding DataContext.ModifyAutoMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="6,4"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{loc:Loc Key=MailboxPerms.ApplyAutoMapTooltip}"
                                                    Visibility="{Binding IsInherited, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            <Button Content="{loc:Loc Key=Btn.Remove}"
                                                    Command="{Binding DataContext.RemovePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="6,4"
                                                    ToolTip="{loc:Loc Key=MailboxPerms.RemovePermissionTooltip}"
                                                    Visibility="{Binding IsInherited, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{loc:Loc Key=MailboxPerms.SendAsHeading}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DataGrid ItemsSource="{Binding SendAsPermissions}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              MaxHeight="200" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColUser}" Binding="{Binding User}" Width="Auto" MinWidth="220"/>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColInherited}" Binding="{Binding IsInherited}" Width="80"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColActions}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc Key=Btn.Remove}"
                                                Command="{Binding DataContext.RemovePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                Padding="6,4"
                                                ToolTip="{loc:Loc Key=MailboxPerms.RemovePermissionTooltip}"
                                                Visibility="{Binding IsInherited, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{loc:Loc Key=MailboxPerms.SendOnBehalfHeading}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <DataGrid ItemsSource="{Binding SendOnBehalfPermissions}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              MaxHeight="200" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColUser}" Binding="{Binding User}" Width="Auto" MinWidth="220"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColActions}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Loc Key=Btn.Remove}"
                                                Command="{Binding DataContext.RemovePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                Padding="6,4"
                                                ToolTip="{loc:Loc Key=MailboxPerms.RemovePermissionTooltip}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Separator Margin="0,4,0,12"/>

                    <TextBlock Text="{loc:Loc Key=MailboxPerms.FolderPermissionsHeading}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource InsetPanelBorderStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=MailboxPerms.FieldFolderPath}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,4"/>
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding FolderPermissionFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"
                                     ToolTip="{loc:Loc Key=MailboxPerms.FolderPathTooltip}"/>
                              <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=MailboxPerms.FieldResolvedTarget}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding FolderPermissionTargetLabel}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <Button Grid.Row="1" Grid.Column="3" Content="{loc:Loc Key=MailboxPerms.BtnLoad}"
                                    Command="{Binding RefreshFolderPermissionsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="{loc:Loc Key=MailboxPerms.ReloadFolderTooltip}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=MailboxPerms.ColUser}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,12,8,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc Key=MailboxPerms.ColRole}"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,12,8,4"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewFolderPermissionUser, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 ToolTip="{loc:Loc Key=MailboxPerms.FolderUserTooltip}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FolderPermissionRoles}"
                                  SelectedItem="{Binding NewFolderPermissionRole}"
                                  Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="{loc:Loc Key=MailboxPerms.BtnGrantUpdate}"
                                Command="{Binding AddFolderPermissionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="{loc:Loc Key=MailboxPerms.GrantUpdateTooltip}"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding FolderPermissions}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{StaticResource SecondaryBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              MaxHeight="220"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColUser}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="220"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColRole}" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.FolderPermissionRoles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding SelectedRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsInherited, Converter={StaticResource InverseBool}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColCurrentRights}" Binding="{Binding AccessRightsSummary}" Width="Auto" MinWidth="180"/>
                            <DataGridTextColumn Header="{loc:Loc Key=MailboxPerms.ColInherited}" Binding="{Binding IsInherited}" Width="80"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=MailboxPerms.ColActions}" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="{loc:Loc Key=MailboxPerms.BtnApply}"
                                                    Command="{Binding DataContext.UpdateFolderPermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="6,4"
                                                    Margin="0,0,4,0"
                                                    Visibility="{Binding IsInherited, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            <Button Content="{loc:Loc Key=Btn.Remove}"
                                                    Command="{Binding DataContext.RemoveFolderPermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="6,4"
                                                    Visibility="{Binding IsInherited, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </controls:SectionPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
