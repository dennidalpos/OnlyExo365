<UserControl x:Class="ExchangeAdmin.Presentation.Views.MailboxSpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                       
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Key=Nav.MailboxStorage}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                <TextBlock Text="{loc:Loc Key=MailboxSpace.SortedByFreeSpace}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Key=Btn.ExportXlsx}"
                        Command="{Binding MailboxSpace.ExportExcelCommand}"
                        Style="{StaticResource InlineActionButton}"/>
                <Button Content="{loc:Loc Key=MailboxSpace.StartScan}"
                        Command="{Binding MailboxSpace.StartScanCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

                      
        <Border Grid.Row="1" Style="{StaticResource WarningBannerBorderStyle}" Margin="0,0,0,12"
                Visibility="{Binding MailboxSpace.HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=MailboxSpace.WarningBanner}" Style="{StaticResource WarningBannerTextStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding MailboxSpace.WarningsText}" Style="{StaticResource StatusBannerMessageTextStyle}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding MailboxSpace.DiagnosticReferenceText}"
                           Style="{StaticResource StatusBannerDetailTextStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding MailboxSpace.HasDiagnosticReference, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ErrorBannerBorderStyle}" Margin="0,0,0,12"
                Visibility="{Binding MailboxSpace.HasError, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=MailboxSpace.ErrorBanner}" Style="{StaticResource ErrorBannerTextStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding MailboxSpace.ErrorMessage}" Style="{StaticResource StatusBannerMessageTextStyle}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding MailboxSpace.DiagnosticReferenceText}"
                           Style="{StaticResource StatusBannerDetailTextStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding MailboxSpace.HasDiagnosticReference, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

                     
        <Grid Grid.Row="3" IsEnabled="{Binding MailboxSpace.IsLoading, Converter={StaticResource InverseBool}}">
            <DataGrid ItemsSource="{Binding MailboxSpace.Mailboxes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="{StaticResource SecondaryBackgroundBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      RowBackground="{StaticResource SecondaryBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=MailboxSpace.ColName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                    <DataGridTextColumn Header="{loc:Loc Key=MailboxSpace.ColEmail}" Binding="{Binding PrimarySmtpAddress}" Width="Auto" MinWidth="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=MailboxSpace.ColUsed}" Binding="{Binding TotalItemSize}" Width="140"/>
                    <DataGridTextColumn Header="{loc:Loc Key=MailboxSpace.ColQuota}" Binding="{Binding QuotaLabel}" Width="140"/>
                    <DataGridTemplateColumn Header="{loc:Loc Key=MailboxSpace.ColRemaining}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RemainingPercentDisplay}" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RemainingCategory}" Value="Critical">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RemainingCategory}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RemainingCategory}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>

                                    
            <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                    Visibility="{Binding MailboxSpace.IsLoading, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MailboxSpace.ProgressStatus, Mode=OneWay, TargetNullValue=Scan in progress...}"
                                   Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                        <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                     Value="{Binding MailboxSpace.ProgressPercent, Mode=OneWay}"/>
                        <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                            <TextBlock Text="{Binding MailboxSpace.ProgressPercentText, Mode=OneWay}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MailboxSpace.ProgressCountText, Mode=OneWay}"
                                       Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                       Visibility="{Binding MailboxSpace.HasProgressCount, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

