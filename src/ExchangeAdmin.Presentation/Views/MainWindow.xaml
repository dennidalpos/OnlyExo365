<Window x:Class="ExchangeAdmin.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:contracts="clr-namespace:ExchangeAdmin.Contracts;assembly=ExchangeAdmin.Contracts"
        xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExchangeAdmin.Presentation.ViewModels"
        xmlns:views="clr-namespace:ExchangeAdmin.Presentation.Views"
        xmlns:ipc="clr-namespace:ExchangeAdmin.Infrastructure.Ipc;assembly=ExchangeAdmin.Infrastructure"
        xmlns:dtos="clr-namespace:ExchangeAdmin.Contracts.Dtos;assembly=ExchangeAdmin.Contracts"
        Title="{loc:Loc Key=Shell.WindowTitle}"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Shell.AppName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="16" Margin="8,0,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageSelection.AvailableLocales}"
                              SelectedItem="{Binding LanguageSelection.SelectedLocale, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Width="90"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Style="{StaticResource HeaderComboBox}"
                              ToolTip="{loc:Loc Key=Shell.LanguageSelectorLabel}"/>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal"
                           Margin="0,12,0,0" HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <Button Content="{loc:Loc Key=Btn.StartWorker}" Command="{Binding StartWorkerCommand}"
                            Style="{StaticResource HeaderPrimaryCommandButton}"/>
                    <Button Content="{loc:Loc Key=Btn.StopWorker}" Command="{Binding StopWorkerCommand}"
                            Style="{StaticResource HeaderCommandButton}"/>
                    <Button Content="{loc:Loc Key=Btn.ConnectExchange}" Command="{Binding ConnectExchangeCommand}"
                            Style="{StaticResource HeaderPrimaryCommandButton}"/>
                    <Button Content="{loc:Loc Key=Btn.Disconnect}" Command="{Binding DisconnectExchangeCommand}"
                            Style="{StaticResource HeaderCommandButton}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Key=Status.WorkerLabel}" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusIndicator}">
                                    <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.Connected}">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.Starting}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.WaitingForHandshake}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.Restarting}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.Crashed}">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding WorkerState}" Value="{x:Static ipc:WorkerConnectionState.Unresponsive}">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding WorkerStateDisplay}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Key=Status.ExchangeLabel}" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusIndicator}">
                                    <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExchangeState}" Value="{x:Static dtos:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExchangeState}" Value="{x:Static dtos:ConnectionState.Connecting}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExchangeState}" Value="{x:Static dtos:ConnectionState.Reconnecting}">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExchangeState}" Value="{x:Static dtos:ConnectionState.Failed}">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExchangeConnectionDisabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ExchangeStateDisplay}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Key=Status.GraphLabel}" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Ellipse Style="{StaticResource StatusIndicator}" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding GraphStateColor}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding GraphStateDisplay}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   ToolTip="{Binding GraphStateTooltip}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource TertiaryBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                    <StackPanel Margin="0,8" IsEnabled="{Binding CanNavigate}">
                    <Button Content="{loc:Loc Key=Nav.Dashboard}" Command="{Binding NavigateToDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Separator Margin="8,8" Background="{StaticResource BorderBrush}"/>

                    <Button Content="{loc:Loc Key=Nav.MailContacts}" Command="{Binding NavigateToContactsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContactsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.ResourceMailboxes}" Command="{Binding NavigateToResourcesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResourcesPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.DistributionLists}" Command="{Binding NavigateToDistributionListsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDistributionListsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Separator Margin="8,8" Background="{StaticResource BorderBrush}"/>

                    <Button Content="{loc:Loc Key=Nav.Mailboxes}" Command="{Binding NavigateToMailboxesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailboxesPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.DeletedMailboxes}" Command="{Binding NavigateToDeletedMailboxesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeletedMailboxesPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.MailboxStorage}" Command="{Binding NavigateToMailboxSpaceCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailboxSpacePage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.MailboxAccess}" Command="{Binding NavigateToMailboxAccessReportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailboxAccessReportPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.PublicFolders}" Command="{Binding NavigateToPublicFoldersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPublicFoldersPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.MobileDevices}" Command="{Binding NavigateToMobileDevicesCommand}"
                            IsEnabled="{Binding CanAccessMobileDevicesPage}"
                            ToolTip="{Binding MobileDevicesNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMobileDevicesPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Separator Margin="8,8" Background="{StaticResource BorderBrush}"/>

                    <Button Content="{loc:Loc Key=Nav.MailFlow}" Command="{Binding NavigateToMailFlowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailFlowPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.MailSecurity}" Command="{Binding NavigateToMailSecurityCommand}"
                            IsEnabled="{Binding CanAccessMailSecurityPage}"
                            ToolTip="{Binding MailSecurityNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMailSecurityPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.MessageTrace}" Command="{Binding NavigateToMessageTraceCommand}"
                            IsEnabled="{Binding CanAccessMessageTracePage}"
                            ToolTip="{Binding MessageTraceNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageTracePage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.Migration}" Command="{Binding NavigateToMigrationCommand}"
                            IsEnabled="{Binding CanAccessMigrationPage}"
                            ToolTip="{Binding MigrationNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMigrationPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.RoleGroups}" Command="{Binding NavigateToPermissionsCommand}"
                            IsEnabled="{Binding CanAccessPermissionsPage}"
                            ToolTip="{Binding PermissionsNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPermissionsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.Compliance}" Command="{Binding NavigateToComplianceCommand}"
                            IsEnabled="{Binding CanAccessCompliancePage}"
                            ToolTip="{Binding ComplianceNavigationTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompliancePage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Separator Margin="8,8" Background="{StaticResource BorderBrush}"/>

                    <Button Content="{loc:Loc Key=Nav.Tools}" Command="{Binding NavigateToToolsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Loc Key=Nav.Logs}" Command="{Binding NavigateToLogsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLogsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource PrimaryBackgroundBrush}">
                <views:DashboardView x:Name="DashboardView"
                                      Visibility="{Binding IsDashboardPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:ContactsView x:Name="ContactsView"
                                     Visibility="{Binding IsContactsPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:ResourcesView x:Name="ResourcesView"
                                     Visibility="{Binding IsResourcesPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:PublicFoldersView x:Name="PublicFoldersView"
                                         Visibility="{Binding IsPublicFoldersPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MobileDevicesView x:Name="MobileDevicesView"
                                         Visibility="{Binding IsMobileDevicesPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MigrationView x:Name="MigrationView"
                                     Visibility="{Binding IsMigrationPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:PermissionsView x:Name="PermissionsView"
                                       Visibility="{Binding IsPermissionsPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MailboxListView x:Name="MailboxListView"
                                        Visibility="{Binding IsMailboxesPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:DeletedMailboxesView x:Name="DeletedMailboxesView"
                                            Visibility="{Binding IsDeletedMailboxesPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MailboxSpaceView x:Name="MailboxSpaceView"
                                        Visibility="{Binding IsMailboxSpacePage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MailboxAccessReportView x:Name="MailboxAccessReportView"
                                        Visibility="{Binding IsMailboxAccessReportPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:DistributionListView x:Name="DistributionListView"
                                             Visibility="{Binding IsDistributionListsPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MessageTraceView x:Name="MessageTraceView"
                                         Visibility="{Binding IsMessageTracePage, Converter={StaticResource BoolToVisibility}}"/>

                <views:ComplianceView x:Name="ComplianceView"
                                       Visibility="{Binding IsCompliancePage, Converter={StaticResource BoolToVisibility}}"/>

                <views:MailSecurityView x:Name="MailSecurityView"
                                         Visibility="{Binding IsMailSecurityPage, Converter={StaticResource BoolToVisibility}}"/>


                <views:MailFlowView x:Name="MailFlowView"
                                     Visibility="{Binding IsMailFlowPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:ToolsView x:Name="ToolsView"
                                  Visibility="{Binding IsToolsPage, Converter={StaticResource BoolToVisibility}}"/>

                <views:LogsView x:Name="LogsView"
                                 Visibility="{Binding IsLogsPage, Converter={StaticResource BoolToVisibility}}"/>

                <Border Panel.ZIndex="100"
                        Margin="24"
                        Padding="16"
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding Prompt.IsOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding Prompt.Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       DockPanel.Dock="Left"/>
                            <Border Width="12"
                                    Height="12"
                                    CornerRadius="6"
                                    Margin="12,2,0,0"
                                    DockPanel.Dock="Right">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Prompt.IsWarning}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Prompt.IsConfirmation}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DockPanel>

                        <TextBlock Text="{Binding Prompt.Message}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0">
                            <Button Content="{loc:Loc Key=Btn.Cancel}"
                                    Command="{Binding Prompt.CancelCommand}"
                                    Style="{StaticResource InlineActionButton}"
                                    Visibility="{Binding Prompt.IsConfirmation, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="{loc:Loc Key=Btn.Confirm}"
                                    Command="{Binding Prompt.ConfirmCommand}"
                                    Style="{StaticResource InlinePrimaryActionButton}"
                                    Visibility="{Binding Prompt.IsConfirmation, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="{loc:Loc Key=Btn.Close}"
                                    Command="{Binding Prompt.CancelCommand}"
                                    Style="{StaticResource InlinePrimaryActionButton}"
                                    Visibility="{Binding Prompt.IsConfirmation, Converter={StaticResource InverseBoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource TertiaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GlobalStatus, FallbackValue='Ready'}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding GlobalProgressPercentText}"
                               Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               Visibility="{Binding IsGlobalOperationRunning, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding GlobalProgressCountText}"
                               Margin="8,0,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding HasGlobalItemProgress, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar Value="{Binding GlobalProgress}" Maximum="100"
                                 Width="100" Height="6" Margin="12,0,0,0"
                                 Visibility="{Binding IsGlobalOperationRunning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Margin="12,0"
                        Padding="8,4"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding Compliance.HasAuditSearchTasks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Compliance.AuditTaskCenterStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <ComboBox ItemsSource="{Binding Compliance.AuditSearchTasks}"
                                  SelectedItem="{Binding Compliance.SelectedAuditSearchTask}"
                                  DisplayMemberPath="TaskSummary"
                                  Width="320"
                                  Margin="8,0,0,0"/>
                        <Button Content="{loc:Loc Key=Btn.OpenCompliance}"
                                Command="{Binding NavigateToComplianceCommand}"
                                Style="{StaticResource InlineActionButton}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0"
                            Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc Key=Shell.ConnectedPrefix}"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ConnectedUser, Mode=OneWay}"
                               Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{x:Static contracts:ProductInfo.DisplayVersion}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
