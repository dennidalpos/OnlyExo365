<UserControl x:Class="ExchangeAdmin.Presentation.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ExchangeAdmin.Presentation.Localization"
             xmlns:controls="clr-namespace:ExchangeAdmin.Presentation.Controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc Key=Permissions.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                    <TextBlock Text="{Binding Permissions.StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Loc Key=Btn.New}" Command="{Binding Permissions.NewRoleGroupCommand}"
                            Style="{StaticResource InlineActionButton}"/>
                    <Button Content="{loc:Loc Key=Btn.Refresh}" Command="{Binding Permissions.RefreshCommand}" Style="{StaticResource InlinePrimaryActionButton}"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource ErrorBannerBorderStyle}"
                    Margin="0,0,0,12"
                    Visibility="{Binding Permissions.HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Permissions.ErrorMessage}" Style="{StaticResource StatusBannerMessageTextStyle}"/>
            </Border>

            <TextBox Grid.Row="2" Text="{Binding Permissions.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <Grid Grid.Row="3" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Permissions.RoleGroups}"
                          SelectedItem="{Binding Permissions.SelectedRoleGroup}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="{StaticResource SecondaryBackgroundBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          RowBackground="{StaticResource SecondaryBackgroundBrush}"
                          AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=Permissions.ColName}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                        <DataGridTextColumn Header="{loc:Loc Key=Permissions.ColDisplayName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="200"/>
                        <DataGridTextColumn Header="{loc:Loc Key=Permissions.ColRoles}" Binding="{Binding RoleCount}" Width="Auto" MinWidth="70"/>
                        <DataGridTextColumn Header="{loc:Loc Key=Permissions.ColMembers}" Binding="{Binding MemberCount}" Width="Auto" MinWidth="75"/>
                        <DataGridTextColumn Header="{loc:Loc Key=Permissions.ColModified}" Binding="{Binding WhenChanged, StringFormat={}{0:g}}" Width="Auto" MinWidth="125"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="1" Content="{loc:Loc Key=Btn.LoadMore}" Command="{Binding Permissions.LoadMoreCommand}"
                        HorizontalAlignment="Center" Margin="0,12,0,0"
                        Style="{StaticResource InlineActionButton}"
                        Visibility="{Binding Permissions.HasMore, Converter={StaticResource BoolToVisibility}}"/>

                <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                        Visibility="{Binding Permissions.IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Permissions.LoadProgress.Status}"
                                       Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                            <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                         Value="{Binding Permissions.LoadProgress.Progress, Mode=OneWay}"/>
                            <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                                <TextBlock Text="{Binding Permissions.LoadProgress.PercentText}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Permissions.LoadProgress.CountText}"
                                           Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                           Visibility="{Binding Permissions.LoadProgress.HasCount, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <controls:SectionPanel Header="{loc:Loc Key=Permissions.RoleGroupDetailsHeading}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding Permissions.SelectedRoleGroupSummary}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Permissions.FieldIdentity}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc Key=Permissions.FieldDescription}" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding Permissions.SelectedRoleGroupDetails.Identity}" IsReadOnly="True" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Permissions.SelectedRoleGroupDetails.Description}" IsReadOnly="True" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Permissions.FieldRbacRoles}" Margin="0,8,8,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Key=Permissions.FieldScopes}" Margin="0,8,8,6"/>
                        <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding Permissions.RolesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Permissions.ScopesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Key=Permissions.FieldManagedBy}" Margin="0,8,8,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Loc Key=Permissions.FieldCreatedChanged}" Margin="0,8,8,6"/>
                        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc Key=Permissions.OwnersPrefix}"/>
                            <TextBlock Text="{Binding Permissions.SelectedRoleGroupDetails.ManagedBy.Count, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Key=Permissions.CreatedPrefix}"/>
                                <TextBlock Text="{Binding Permissions.SelectedRoleGroupDetails.WhenCreated, StringFormat={}{0:g}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Key=Permissions.ChangedPrefix}"/>
                                <TextBlock Text="{Binding Permissions.SelectedRoleGroupDetails.WhenChanged, StringFormat={}{0:g}}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource SecondaryBackgroundBrush}"
                                Padding="8" Margin="0,12,0,0"
                                Visibility="{Binding Permissions.IsLoadingDetails, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Key=Permissions.LoadingDetails}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </controls:SectionPanel>

                <controls:SectionPanel Header="{loc:Loc Key=Permissions.MembershipHeading}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Permissions.MembersCountText}" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Permissions.MemberToAdd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="{loc:Loc Key=Permissions.AddMember}" Command="{Binding Permissions.AddMemberCommand}" Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Permissions.SelectedRoleGroupDetails.Members}"
                                 SelectedItem="{Binding Permissions.SelectedMember}"
                                 DisplayMemberPath="DisplayName"
                                 Background="{StaticResource SecondaryBackgroundBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"/>

                        <Button Grid.Row="3" Content="{loc:Loc Key=Permissions.RemoveMemberSelected}"
                                Command="{Binding Permissions.RemoveSelectedMemberCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </controls:SectionPanel>

                <controls:SectionPanel Header="{loc:Loc Key=Permissions.NewGroupHeading}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Permissions.ColName}" Margin="0,0,8,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=Permissions.FieldCopyFrom}" Margin="0,0,8,6"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Permissions.NewRoleGroupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Permissions.RoleGroups}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Identity"
                                  SelectedValue="{Binding Permissions.CopyFromRoleGroupIdentity}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Permissions.FieldDescription}" Margin="0,8,8,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc Key=Permissions.FieldRolesCsv}" Margin="0,8,8,6"/>
                        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding Permissions.NewRoleGroupDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Permissions.NewRoleGroupRoles, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{loc:Loc Key=Permissions.CopyHint}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,6"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{loc:Loc Key=Permissions.InitialMembers}" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding Permissions.NewRoleGroupMembers, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"/>

                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{loc:Loc Key=Permissions.SaveRoleGroup}" Command="{Binding Permissions.SaveRoleGroupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc Key=Permissions.Reset}" Command="{Binding Permissions.NewRoleGroupCommand}"
                                    Style="{StaticResource InlineActionButton}"/>
                        </StackPanel>
                    </Grid>
                </controls:SectionPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
