<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OnlyExo365.Shell</RootNamespace>
    <AssemblyName>OnlyExo365.Shell</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnlyExo365.Contracts\OnlyExo365.Contracts.csproj" />
    <ProjectReference Include="..\OnlyExo365.Worker\OnlyExo365.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\Strings.it.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnlyExo365.Tests" />
  </ItemGroup>

                                                     
  <Target Name="CopyWorkerToOutput" AfterTargets="Build">
    <MSBuild Projects="..\OnlyExo365.Worker\OnlyExo365.Worker.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerTargetPath" />
    </MSBuild>

    <PropertyGroup>
      <_WorkerOutputDir>$([System.IO.Path]::GetDirectoryName('%(_WorkerTargetPath.Identity)'))</_WorkerOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <WorkerFiles Include="$(_WorkerOutputDir)\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

