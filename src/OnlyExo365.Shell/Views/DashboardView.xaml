<UserControl x:Class="OnlyExo365.Shell.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization"
             xmlns:controls="clr-namespace:OnlyExo365.Shell.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{loc:Loc Key=Dashboard.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>

            <Button Grid.Column="2" Content="{loc:Loc Key=Btn.Refresh}" Command="{Binding Dashboard.RefreshCommand}"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WarningBannerBorderStyle}" Margin="0,0,0,16"
                Visibility="{Binding Dashboard.HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Dashboard.Warnings}" Style="{StaticResource WarningBannerTextStyle}" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Dashboard.Warnings}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource WarningBannerTextStyle}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Dashboard.DiagnosticReferenceText}"
                           Style="{StaticResource StatusBannerDetailTextStyle}"
                           Margin="0,8,0,0"
                           Visibility="{Binding Dashboard.HasDiagnosticReference, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="4"
                Style="{StaticResource InsetPanelBorderStyle}"
                Visibility="{Binding IsExchangeConnected, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <TextBlock Text="{loc:Loc Key=Dashboard.DisconnectedTitle}"
                           Style="{StaticResource SectionHeadingTextStyle}"
                           TextAlignment="Center"/>
                <TextBlock Text="{loc:Loc Key=Dashboard.DisconnectedMessage}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2"
              Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SectionPanel Grid.Column="0" Header="{loc:Loc Key=Dashboard.MailboxesGroup}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0"
                            Content="{loc:Loc Key=Dashboard.UserMailboxes}"
                            Command="{Binding NavigateToMailboxesCommand}"
                            Style="{StaticResource SummaryLinkButton}"
                            ToolTip="{loc:Loc Key=Dashboard.UserMailboxesTooltip}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Dashboard.UserMailboxCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Row="1" Grid.Column="0"
                            Content="{loc:Loc Key=Dashboard.SharedMailboxes}"
                            Command="{Binding NavigateToSharedMailboxesCommand}"
                            Style="{StaticResource SummaryLinkButton}"
                            ToolTip="{loc:Loc Key=Dashboard.SharedMailboxesTooltip}"
                            Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dashboard.SharedMailboxCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource InfoBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Dashboard.RoomMailboxes}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dashboard.RoomMailboxCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource InfoBrush}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Dashboard.EquipmentMailboxes}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dashboard.EquipmentMailboxCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource InfoBrush}"/>

                    <Separator Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,8"
                               Background="{StaticResource BorderBrush}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc Key=Dashboard.Total}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Dashboard.TotalMailboxCount}" FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="*" Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding Dashboard.IsApproximate, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="{loc:Loc Key=Dashboard.ApproximateCount}"/>
                    </StackPanel>
                </Grid>
            </controls:SectionPanel>

            <controls:SectionPanel Grid.Column="1" Header="{loc:Loc Key=Dashboard.DistributionGroupsGroup}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0"
                            Content="{loc:Loc Key=Dashboard.DistributionGroups}"
                            Command="{Binding NavigateToDistributionListsCommand}"
                            Style="{StaticResource SummaryLinkButton}"
                            ToolTip="{loc:Loc Key=Dashboard.DistributionGroupsTooltip}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Dashboard.DistributionGroupCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Foreground="{StaticResource InfoBrush}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Dashboard.DynamicGroups}" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dashboard.DynamicDistributionGroupCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource InfoBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Dashboard.M365Groups}" Margin="0,8,0,0"
                               Visibility="{Binding Dashboard.ShowUnifiedGroups, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dashboard.UnifiedGroupCount}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" Margin="0,8,0,0" Foreground="{StaticResource InfoBrush}"
                               Visibility="{Binding Dashboard.ShowUnifiedGroups, Converter={StaticResource BoolToVisibility}}"/>

                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,8"
                               Background="{StaticResource BorderBrush}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Key=Dashboard.Total}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Dashboard.TotalGroupCount}" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
                </Grid>
            </controls:SectionPanel>
        </Grid>

        <!-- License counters with progress bars -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0"
                    Visibility="{Binding Dashboard.HasLicenses, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Loc Key=Dashboard.TenantLicenses}" Style="{StaticResource SectionHeadingTextStyle}"/>
            <ItemsControl ItemsSource="{Binding Dashboard.Licenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:Loc Key=Dashboard.SkuPrefix}" Style="{StaticResource CaptionTextStyle}"/>
                                            <TextBlock Text="{Binding SkuPartNumber}" Style="{StaticResource CaptionTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{loc:Loc Key=Dashboard.LicensesTotal}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Total, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding Total}"
                                             Value="{Binding Assigned, Mode=OneWay}"
                                             Height="6" Margin="0,6,0,4"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource TertiaryBackgroundBrush}"/>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Key=Dashboard.LicensesAssigned}" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="{Binding Assigned, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{loc:Loc Key=Dashboard.LicensesAvailable}" Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBlock Text="{Binding Available, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Admin users table -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0"
                    Visibility="{Binding Dashboard.HasAdminUsers, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Loc Key=Dashboard.AdminUsers}" Style="{StaticResource SectionHeadingTextStyle}"/>
            <DataGrid ItemsSource="{Binding Dashboard.AdminUsers}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="{StaticResource SecondaryBackgroundBrush}"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      RowBackground="{StaticResource SecondaryBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      HeadersVisibility="Column"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=Dashboard.ColName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Dashboard.ColUpn}" Binding="{Binding UserPrincipalName}" Width="Auto" MinWidth="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Dashboard.ColRole}" Binding="{Binding RoleName}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0"
              Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource ErrorBannerBorderStyle}" Margin="0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Visibility="{Binding Dashboard.HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Dashboard.ErrorBanner}" Style="{StaticResource ErrorBannerTextStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Dashboard.ErrorMessage}" Style="{StaticResource StatusBannerMessageTextStyle}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Dashboard.DiagnosticReferenceText}"
                               Style="{StaticResource StatusBannerDetailTextStyle}"
                               Margin="0,8,0,0"
                               Visibility="{Binding Dashboard.HasDiagnosticReference, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Grid.RowSpan="3"
              Background="Transparent"
              Visibility="{Binding Dashboard.IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}">
                <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Dashboard.LoadingStatus}"
                                   Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                        <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                     Value="{Binding Dashboard.LoadingProgress, Mode=OneWay}"/>
                        <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                            <TextBlock Text="{Binding Dashboard.LoadingPercentText}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Dashboard.LoadingCountText}"
                                       Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                       Visibility="{Binding Dashboard.HasLoadingItemProgress, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>

