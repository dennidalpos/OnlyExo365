<UserControl x:Class="OnlyExo365.Shell.Views.DeletedMailboxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Key=DeletedMailbox.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                <TextBlock Text="{Binding DeletedMailboxes.StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Loc Key=DeletedMailbox.LoadList}" Command="{Binding DeletedMailboxes.LoadAllCommand}"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Content="{loc:Loc Key=Btn.Cancel}" Command="{Binding DeletedMailboxes.CancelCommand}"
                        Style="{StaticResource DangerButton}"
                        Visibility="{Binding DeletedMailboxes.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="{loc:Loc Key=DeletedMailbox.UpnLabel}"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,0,0,4"/>

            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding DeletedMailboxes.UpnQuery, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Tag" Value="{loc:Loc Key=DeletedMailbox.UpnPlaceholder}"/>
                        <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=DeletedMailbox.UpnLabel}"/>
                        <Setter Property="ToolTip" Value="{loc:Loc Key=DeletedMailbox.UpnTooltip}"/>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Button Grid.Row="1" Grid.Column="1" Content="{loc:Loc Key=DeletedMailbox.CheckUpn}" Command="{Binding DeletedMailboxes.CheckUpnCommand}"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="{loc:Loc Key=DeletedMailbox.CheckUpnTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=DeletedMailbox.CheckUpn}"/>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="{loc:Loc Key=DeletedMailbox.IncludeSoftDeleted}"
                          IsChecked="{Binding DeletedMailboxes.IncludeSoftDeleted}" Margin="0,0,16,0"/>
                <CheckBox Content="{loc:Loc Key=DeletedMailbox.IncludeInactive}"
                          IsChecked="{Binding DeletedMailboxes.IncludeInactive}"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                       Margin="0,8,0,0"
                       Text="{loc:Loc Key=DeletedMailbox.ListDescription}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding DeletedMailboxes.Mailboxes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="{StaticResource SecondaryBackgroundBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      RowBackground="{StaticResource SecondaryBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource TertiaryBackgroundBrush}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColDisplayName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="180"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColUPN}" Binding="{Binding UserPrincipalName, TargetNullValue=—, FallbackValue=—}" Width="Auto" MinWidth="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColEmail}" Binding="{Binding PrimarySmtpAddress}" Width="Auto" MinWidth="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Mailbox.List.ColType}" Binding="{Binding RecipientTypeDetails}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc Key=DeletedMailbox.ColStatus}" Binding="{Binding DeletionType}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                    Visibility="{Binding DeletedMailboxes.IsLoading, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DeletedMailboxes.LoadProgress.Status}"
                                   Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                        <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                     Value="{Binding DeletedMailboxes.LoadProgress.Progress, Mode=OneWay}"/>
                        <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                            <TextBlock Text="{Binding DeletedMailboxes.LoadProgress.PercentText}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DeletedMailboxes.LoadProgress.CountText}"
                                       Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                       Visibility="{Binding DeletedMailboxes.LoadProgress.HasCount, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Border Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                    Visibility="{Binding DeletedMailboxes.HasError, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CompactErrorOverlayCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=DeletedMailbox.ErrorTitle}" Style="{StaticResource CompactErrorOverlayTitleTextStyle}"/>
                        <TextBlock Text="{Binding DeletedMailboxes.ErrorMessage}" Style="{StaticResource CompactErrorOverlayMessageTextStyle}" MaxWidth="400"/>
                        <Button Content="{loc:Loc Key=Btn.Retry}" Command="{Binding DeletedMailboxes.LoadAllCommand}" Margin="0,12,0,0"
                                Style="{StaticResource InlinePrimaryActionButton}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="{loc:Loc Key=Btn.LoadMore}" Command="{Binding DeletedMailboxes.LoadMoreCommand}"
                    Style="{StaticResource InlineActionButton}"
                    Visibility="{Binding DeletedMailboxes.HasMore, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Grid>
</UserControl>

