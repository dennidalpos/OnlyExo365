<UserControl x:Class="OnlyExo365.Shell.Views.DistributionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization"
             xmlns:controls="clr-namespace:OnlyExo365.Shell.Controls">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Key=Distribution.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                    <TextBlock Text="{Binding DistributionLists.StatusText}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Refresh}" Command="{Binding DistributionLists.RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Margin="0,0,12,0"
                         Text="{Binding DistributionLists.SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1" Width="180" Margin="0,0,12,0"
                          ItemsSource="{Binding DistributionLists.GroupTypeFilters}"
                          SelectedItem="{Binding DistributionLists.SelectedGroupTypeFilter}"/>

                <CheckBox Grid.Column="2" Content="{loc:Loc Key=Distribution.IncludeDynamic}"
                          IsChecked="{Binding DistributionLists.IncludeDynamic}"
                          IsEnabled="{Binding DistributionLists.CanIncludeDynamicFilter}"
                          VerticalAlignment="Center"/>
            </Grid>

            <controls:SectionPanel Grid.Row="2" Header="{loc:Loc Key=Distribution.NewGroupHeader}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Distribution.DisplayName}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Key=Distribution.Alias}" Margin="0,0,8,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc Key=Distribution.EmailLocalPart}" Margin="0,0,8,6"/>

                    <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding DistributionLists.NewDistributionListDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,0"
                             Text="{Binding DistributionLists.NewDistributionListAlias, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,8,0"
                             Text="{Binding DistributionLists.NewDistributionListLocalPart, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="{loc:Loc Key=Btn.Create}"
                            Command="{Binding DistributionLists.CreateDistributionListCommand}"
                            Style="{StaticResource PrimaryButton}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Distribution.EmailDomain}" Margin="0,8,8,6"/>
                    <ComboBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding DistributionLists.AvailableMailDomains}"
                              SelectedItem="{Binding DistributionLists.SelectedDistributionListDomain}"
                              Margin="0,0,8,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{loc:Loc Key=Distribution.DistributionGroupOnly}"/>
                </Grid>
            </controls:SectionPanel>

            <DataGrid Grid.Row="3" ItemsSource="{Binding DistributionLists.DistributionLists}"
                      SelectedItem="{Binding DistributionLists.SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=Distribution.ColDisplayName}" Binding="{Binding DisplayName}" Width="Auto" MinWidth="200"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Distribution.ColEmail}" Binding="{Binding PrimarySmtpAddress}" Width="Auto" MinWidth="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Distribution.ColType}" Binding="{Binding GroupType}" Width="140"/>
                    <DataGridTextColumn Header="{loc:Loc Key=Distribution.ColRecipientTypeDetails}" Binding="{Binding RecipientTypeDetails}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="4" Content="{loc:Loc Key=Btn.LoadMore}" Command="{Binding DistributionLists.LoadMoreCommand}"
                    Style="{StaticResource InlineActionButton}"
                    HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="{Binding DistributionLists.HasMore, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <Grid Grid.Column="2" Margin="16,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock Text="{loc:Loc Key=Distribution.EmptyState}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding DistributionLists.HasDetails, Converter={StaticResource InverseBoolToVisibility}}"/>

                    <StackPanel Visibility="{Binding DistributionLists.HasDetails, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding DistributionLists.SelectedDetails.DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DistributionLists.SelectedDetails.PrimarySmtpAddress}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding DistributionLists.CurrentGroupTypeLabel}"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="{loc:Loc Key=Distribution.BackBtn}"
                                    Command="{Binding DistributionLists.BackCommand}"
                                    Style="{StaticResource InlineActionButton}"/>
                        </Grid>

                        <Border Style="{StaticResource WarningBannerBorderStyle}" Margin="0,0,0,12"
                                Visibility="{Binding DistributionLists.HasPendingSettingsChanges, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Distribution.UnsavedChangesLabel}" Style="{StaticResource WarningBannerTextStyle}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:Loc Key=Btn.Save}" Command="{Binding DistributionLists.SaveSettingsCommand}"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="{loc:Loc Key=Btn.Cancel}" Command="{Binding DistributionLists.DiscardSettingsCommand}"
                                            Style="{StaticResource InlineActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <controls:SectionPanel Header="{loc:Loc Key=Distribution.GroupDetailsGroup}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Key=Distribution.FieldAlias}" Margin="0,0,12,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DistributionLists.SelectedDetails.Alias}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Key=Distribution.FieldAccess}" Margin="0,4,12,4"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistributionLists.SelectedDetails.AccessType}"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Key=Distribution.FieldClassification}" Margin="0,4,12,4"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DistributionLists.SelectedDetails.Classification}"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Key=Distribution.FieldNotes}" Margin="0,4,12,0"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DistributionLists.SelectedDetails.Notes}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding DistributionLists.ShowMicrosoft365Metadata, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </controls:SectionPanel>

                        <controls:SectionPanel Header="{loc:Loc Key=Distribution.OwnersGroup}" Margin="0,0,0,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DistributionLists.SelectedDetails.ManagedBy}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding DistributionLists.SelectedDetails.Owners.Members}"
                                              Visibility="{Binding DistributionLists.HasOwners, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="0,2" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:SectionPanel>

                        <controls:SectionPanel Header="{loc:Loc Key=Distribution.EmailAddressesGroup}" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding DistributionLists.SelectedDetails.EmailAddresses}"/>
                        </controls:SectionPanel>

                        <controls:SectionPanel Header="{loc:Loc Key=Distribution.DeliverySettingsGroup}" Margin="0,0,0,12"
                                  Visibility="{Binding DistributionLists.CanEditSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <CheckBox Content="{loc:Loc Key=Distribution.AllowExternalSenders}"
                                          IsChecked="{Binding DistributionLists.AllowExternalSenders}"
                                          IsEnabled="{Binding DistributionLists.CanEditExternalSenders}"/>

                                <TextBlock Text="{loc:Loc Key=Distribution.AcceptFrom}" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding DistributionLists.AcceptMessagesOnlyFrom}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Remove}"
                                                        Command="{Binding DataContext.DistributionLists.RemoveAcceptSenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding DistributionLists.CanEditAcceptMessagesOnlyFrom}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding DistributionLists.NewAcceptedSender, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Add}"
                                            Command="{Binding DistributionLists.AddAcceptSenderCommand}"
                                            Style="{StaticResource InlineActionButton}"/>
                                </Grid>

                                <TextBlock Text="{loc:Loc Key=Distribution.RejectFrom}" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding DistributionLists.RejectMessagesFrom}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Remove}"
                                                        Command="{Binding DataContext.DistributionLists.RemoveRejectSenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding DistributionLists.CanEditRejectMessagesFrom}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding DistributionLists.NewRejectedSender, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Add}"
                                            Command="{Binding DistributionLists.AddRejectSenderCommand}"
                                            Style="{StaticResource InlineActionButton}"/>
                                </Grid>
                            </StackPanel>
                        </controls:SectionPanel>

                        <controls:SectionPanel Header="{loc:Loc Key=Distribution.MembersGroup}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource WarningBannerBorderStyle}" Padding="8" Margin="0,0,0,8"
                                        Visibility="{Binding DistributionLists.IsDynamicGroup, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Key=Distribution.DynamicGroupMembersCalculated}"
                                                   Style="{StaticResource WarningBannerTextStyle}"/>
                                        <TextBlock Text="{loc:Loc Key=Distribution.MemberPreviewHint}"
                                                   Style="{StaticResource StatusBannerDetailTextStyle}"/>
                                        <Button Content="{loc:Loc Key=Distribution.MemberPreview}"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DistributionLists.PreviewDynamicMembersCommand}"
                                                Style="{StaticResource InlineActionButton}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding DistributionLists.MembersStatusText}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,0,8"/>

                                <ListBox Grid.Row="2" ItemsSource="{Binding DistributionLists.Members}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <TextBlock Text="{Binding PrimarySmtpAddress}" FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{loc:Loc Key=Btn.Remove}"
                                                        Command="{Binding DataContext.DistributionLists.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.DistributionLists.CanModifyMembers, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="3" Margin="0,8,0,0"
                                      Visibility="{Binding DistributionLists.CanModifyMembers, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                                             Text="{Binding DistributionLists.NewMemberIdentity, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{loc:Loc Key=Distribution.AddMember}"
                                            Command="{Binding DistributionLists.AddMemberCommand}"
                                            Style="{StaticResource InlineActionButton}"/>
                                </Grid>
                            </Grid>
                        </controls:SectionPanel>

                        <Button Content="{loc:Loc Key=Distribution.LoadMoreMembers}" Margin="0,8,0,0"
                                Command="{Binding DistributionLists.LoadMoreMembersCommand}"
                                Style="{StaticResource InlineActionButton}"
                                Visibility="{Binding DistributionLists.MembersHasMore, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.ColumnSpan="3"
                Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                Visibility="{Binding DistributionLists.IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DistributionLists.LoadingOverlayText}"
                               Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                    <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                 Value="{Binding DistributionLists.LoadProgress.Progress, Mode=OneWay}"
                                 />
                    <StackPanel Style="{StaticResource CompactLoadingOverlayMetricsPanelStyle}">
                        <TextBlock Text="{Binding DistributionLists.LoadProgress.PercentText}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DistributionLists.LoadProgress.CountText}"
                                   Style="{StaticResource CompactLoadingOverlayCountTextStyle}"
                                   Visibility="{Binding DistributionLists.LoadProgress.HasCount, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>


