<UserControl x:Class="OnlyExo365.Shell.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                       
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Key=Logs.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0"/>
                    <TextBlock Text="{Binding Logs.TotalCount, StringFormat={loc:Loc Key=Logs.EntryCount}}" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Logs.PersistentLogPolicySummary}" Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"/>
                <TextBlock Text="{Binding Logs.PersistentLogDirectory}" Margin="0,2,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Logs.PersistentLogDirectory}"/>
                <TextBlock Text="{Binding Logs.PersistentObservabilitySummary}" Margin="0,2,0,0"
                           Style="{StaticResource CaptionTextStyle}"/>
                <TextBlock Text="{Binding Logs.PersistentObservabilitySummaryPath}" Margin="0,2,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Logs.PersistentObservabilitySummaryPath}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{loc:Loc Key=Btn.Copy}" Command="{Binding Logs.CopyLogsCommand}" Style="{StaticResource ActionGroupButton}"/>
                <Button Content="{loc:Loc Key=Btn.ExportBundle}" Command="{Binding Logs.ExportPersistentLogsCommand}" Style="{StaticResource ActionGroupButton}"/>
                <Button Content="{loc:Loc Key=Btn.Clear}" Command="{Binding Logs.ClearLogsCommand}"
                        Style="{StaticResource ActionGroupDangerButton}"/>
            </StackPanel>
        </Grid>

                           
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:Loc Key=Logs.SearchLabel}"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{loc:Loc Key=Logs.LevelFilterLabel}"
                       Style="{StaticResource CaptionTextStyle}"
                       Margin="0,0,12,4"/>

            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding Logs.SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0"
                     ToolTip="{loc:Loc Key=Logs.SearchTooltip}"
                     AutomationProperties.Name="{loc:Loc Key=Logs.SearchLabel}"/>

            <ComboBox Grid.Row="1" Grid.Column="1" Width="120" SelectedValue="{Binding Logs.FilterLevel, Mode=TwoWay}"
                      SelectedValuePath="Tag" Margin="0,0,12,0"
                      ToolTip="{loc:Loc Key=Logs.FilterTooltip}"
                      AutomationProperties.Name="{loc:Loc Key=Logs.LevelFilterLabel}">
                <ComboBoxItem Content="{loc:Loc Key=Logs.FilterAll}" Tag="{x:Static local:LogLevel.Verbose}" IsSelected="True"
                              xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts"/>
                <ComboBoxItem Content="{loc:Loc Key=Logs.FilterDebugPlus}" Tag="{x:Static local:LogLevel.Debug}"
                              xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts"/>
                <ComboBoxItem Content="{loc:Loc Key=Logs.FilterInfoPlus}" Tag="{x:Static local:LogLevel.Information}"
                              xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts"/>
                <ComboBoxItem Content="{loc:Loc Key=Logs.FilterWarningPlus}" Tag="{x:Static local:LogLevel.Warning}"
                              xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts"/>
                <ComboBoxItem Content="{loc:Loc Key=Logs.FilterError}" Tag="{x:Static local:LogLevel.Error}"
                              xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts"/>
            </ComboBox>

                                 
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Background="{StaticResource SuccessChipBackgroundBrush}" Style="{StaticResource StatusChipBorderStyle}"
                        ToolTip="{loc:Loc Key=Logs.TooltipInfo}">
                    <TextBlock Text="{Binding Logs.InfoCount}" Foreground="{StaticResource SuccessBrush}" Style="{StaticResource StatusChipValueTextStyle}"/>
                </Border>
                <Border Background="{StaticResource WarningChipBackgroundBrush}" Style="{StaticResource StatusChipBorderStyle}"
                        ToolTip="{loc:Loc Key=Logs.TooltipWarning}">
                    <TextBlock Text="{Binding Logs.WarningCount}" Foreground="{StaticResource WarningBrush}" Style="{StaticResource StatusChipValueTextStyle}"/>
                </Border>
                <Border Background="{StaticResource ErrorChipBackgroundBrush}" Style="{StaticResource StatusChipBorderStyle}"
                        ToolTip="{loc:Loc Key=Logs.TooltipError}">
                    <TextBlock Text="{Binding Logs.ErrorCount}" Foreground="{StaticResource ErrorBrush}" Style="{StaticResource StatusChipValueTextStyle}"/>
                </Border>
            </StackPanel>
        </Grid>

                         
        <ListBox Grid.Row="2" ItemsSource="{Binding Logs.FilteredLogs}"
                 FontFamily="Consolas" FontSize="11"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Background="{StaticResource SecondaryBackgroundBrush}"
                 BorderBrush="{StaticResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LevelIcon}" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding LevelColor}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Source}"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding CorrelationDisplay}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   ToolTip="{Binding CorrelationDisplay}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Message}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="4,2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static local:LogLevel.Error}"
                                     xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts">
                            <Setter Property="Background" Value="{StaticResource ErrorChipBackgroundBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static local:LogLevel.Warning}"
                                     xmlns:local="clr-namespace:OnlyExo365.Contracts.Messages;assembly=OnlyExo365.Contracts">
                            <Setter Property="Background" Value="{StaticResource WarningChipBackgroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>

