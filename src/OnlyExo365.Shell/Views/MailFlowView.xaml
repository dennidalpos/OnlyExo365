                            <CheckBox Content="{loc:Loc Key=MailFlow.DeliveryReportEnabled}" IsChecked="{Binding MailFlow.OrganizationRelationshipDeliveryReportEnabled}" Margin="0,2,0,0"/>
                            <CheckBox Content="{loc:Loc Key=MailFlow.MailboxMoveEnabled}" IsChecked="{Binding MailFlow.OrganizationRelationshipMailboxMoveEnabled}" Margin="0,2,0,0"/>
                            <CheckBox Content="{loc:Loc Key=MailFlow.PhotosEnabled}" IsChecked="{Binding MailFlow.OrganizationRelationshipPhotosEnabled}" Margin="0,2,0,0"/>
