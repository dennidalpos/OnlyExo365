                                    IsEnabled="{Binding MailFlow.IsSharingPolicyInputValid}"/>
                        </StackPanel>
                    </controls:SectionPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.ColumnSpan="3"
                    Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                    Visibility="{Binding MailFlow.IsLoading, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MailFlow.LoadingOverlayText}"
                                   Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

