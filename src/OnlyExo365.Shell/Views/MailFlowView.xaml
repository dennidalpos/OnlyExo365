                            <TextBlock Text="{loc:Loc Key=MailFlow.Name}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressBookPolicyName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding MailFlow.CanEditSelectedAddressBookPolicy}"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.AddressListsCsvIdentities}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressBookPolicyAddressLists, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
