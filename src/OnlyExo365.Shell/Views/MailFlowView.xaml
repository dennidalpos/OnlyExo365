                            <CheckBox Content="{loc:Loc Key=MailFlow.MakeDefault}" IsChecked="{Binding MailFlow.SharingPolicyMakeDefault}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding MailFlow.SharingPolicyValidationMessage}" Style="{StaticResource InlineValidationTextStyle}"
                                       Visibility="{Binding MailFlow.IsSharingPolicyInputValid, Converter={StaticResource InverseBoolToVisibility}}"/>
