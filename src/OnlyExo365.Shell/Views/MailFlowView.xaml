                                    IsEnabled="{Binding MailFlow.IsOfflineAddressBookInputValid}"/>
                        </StackPanel>
                    </controls:SectionPanel>

                    <controls:SectionPanel Header="{loc:Loc Key=MailFlow.CreateEditSharingPolicy}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=MailFlow.IdentityEditOnly}"/>
                            <TextBox Text="{Binding MailFlow.SharingPolicyIdentity}" IsReadOnly="True"/>
                            <CheckBox Content="{loc:Loc Key=MailFlow.DefaultSharingPolicy}" IsChecked="{Binding MailFlow.SharingPolicyIsDefault}" Margin="0,6,0,0" IsEnabled="False"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.Name}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.SharingPolicyName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding MailFlow.CanEditSelectedSharingPolicy}"/>
