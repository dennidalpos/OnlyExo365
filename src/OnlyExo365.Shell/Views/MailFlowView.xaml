                            <Button Content="{loc:Loc Key=MailFlow.SaveOrganizationRelationship}" Command="{Binding MailFlow.SaveOrganizationRelationshipCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                    IsEnabled="{Binding MailFlow.IsOrganizationRelationshipInputValid}"/>
                        </StackPanel>
                    </controls:SectionPanel>

                    <controls:SectionPanel Header="{loc:Loc Key=MailFlow.CreateEditAddressList}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding MailFlow.AddressListSectionWarningMessage}"
                                       Style="{StaticResource InlineValidationTextStyle}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding MailFlow.HasAddressListSectionWarning, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.IdentityEditOnly}"/>
                            <TextBox Text="{Binding MailFlow.AddressListIdentity}" IsReadOnly="True"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.Name}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressListName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding MailFlow.CanEditSelectedAddressList}"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.DisplayName}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressListDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.RecipientFilterCustom}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressListRecipientFilter, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
