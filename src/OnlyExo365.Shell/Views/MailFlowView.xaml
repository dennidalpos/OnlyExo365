                            <TextBox Text="{Binding MailFlow.AddressListRecipientContainer, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Loc Key=MailFlow.IncludedRecipientsCsv}" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding MailFlow.AddressListIncludedRecipients, UpdateSourceTrigger=PropertyChanged}"/>
