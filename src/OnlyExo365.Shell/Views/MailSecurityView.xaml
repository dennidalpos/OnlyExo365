<UserControl x:Class="OnlyExo365.Shell.Views.MailSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization">

    <Grid Margin="16" IsEnabled="{Binding MailSecurity.IsBusy, Converter={StaticResource InverseBool}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Key=MailSecurity.Title}" Style="{StaticResource PageTitleTextStyle}" Margin="0" DockPanel.Dock="Left"/>
            <Button Content="{loc:Loc Key=MailSecurity.RefreshWorkspaceBtn}"
                    Command="{Binding MailSecurity.RefreshWorkspaceCommand}"
                    Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ErrorBannerBorderStyle}"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding MailSecurity.HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding MailSecurity.ErrorMessage}"
                           Style="{StaticResource ErrorBannerTextStyle}"/>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource WarningBannerBorderStyle}"
                    Padding="8"
                    Margin="0,0,0,8"
                    Visibility="{Binding MailSecurity.HasWarnings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding MailSecurity.WarningsText}"
                           Style="{StaticResource WarningBannerTextStyle}"/>
            </Border>

            <TabControl Grid.Row="2">
                <TabItem Header="{loc:Loc Key=MailSecurity.DKIM}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding MailSecurity.DkimConfigs}"
                                  SelectedItem="{Binding MailSecurity.SelectedDkimConfig}"
                                  AutoGenerateColumns="False"
                                  MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Domain}" Binding="{Binding Domain}" Width="Auto" MinWidth="200"/>
                                <DataGridCheckBoxColumn Header="{loc:Loc Key=MailSecurity.Enabled}" Binding="{Binding Enabled}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Selector1}" Binding="{Binding Selector1CName}" Width="Auto" MinWidth="220"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Selector2}" Binding="{Binding Selector2CName}" Width="Auto" MinWidth="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedDKIMConfig}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputLabel001" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Domain}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel001}" Text="{Binding MailSecurity.SelectedDkimConfig.Domain}" IsReadOnly="True"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.Enabled}"
                                      IsChecked="{Binding MailSecurity.DkimEnabled}"
                                      Margin="0,12,0,0"/>
                            <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveDKIM}"
                                    Command="{Binding MailSecurity.SaveDkimCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Key=MailSecurity.AntiSpam}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding MailSecurity.AntiSpamPolicies}"
                                  SelectedItem="{Binding MailSecurity.SelectedAntiSpamPolicy}"
                                  AutoGenerateColumns="False"
                                  MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Policy}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.RuleState}" Binding="{Binding RuleState}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Priority}" Binding="{Binding Priority}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Bulk}" Binding="{Binding BulkThreshold}" Width="Auto" MinWidth="70"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.SpamAction}" Binding="{Binding SpamAction}" Width="Auto" MinWidth="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedAntiSpamPolicy}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputLabel002" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel002}" Text="{Binding MailSecurity.SelectedAntiSpamPolicy.Name}" IsReadOnly="True"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.RuleEnabled}"
                                      IsChecked="{Binding MailSecurity.AntiSpamRuleEnabled}"
                                      Margin="0,12,0,0"
                                      IsEnabled="{Binding MailSecurity.SelectedAntiSpamHasRule}"/>
                            <TextBlock x:Name="InputLabel003" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.BulkThreshold}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel003}" Text="{Binding MailSecurity.AntiSpamBulkThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="InputLabel004" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.SpamAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel004}" ItemsSource="{Binding MailSecurity.SpamActions}"
                                      Text="{Binding MailSecurity.AntiSpamSpamAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <TextBlock x:Name="InputLabel005" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.HighConfidenceSpamAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel005}" ItemsSource="{Binding MailSecurity.SpamActions}"
                                      Text="{Binding MailSecurity.AntiSpamHighConfidenceSpamAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <TextBlock x:Name="InputLabel006" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.PhishSpamAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel006}" ItemsSource="{Binding MailSecurity.SpamActions}"
                                      Text="{Binding MailSecurity.AntiSpamPhishSpamAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveAntiSpamPolicy}"
                                    Command="{Binding MailSecurity.SaveAntiSpamCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Key=MailSecurity.AntiPhish}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid MaxHeight="320" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Column="0"
                                      ItemsSource="{Binding MailSecurity.AntiPhishPolicies}"
                                      SelectedItem="{Binding MailSecurity.SelectedAntiPhishPolicy}"
                                      AutoGenerateColumns="False"
                                      MinHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Policy}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.RuleState}" Binding="{Binding RuleState}" Width="Auto" MinWidth="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Priority}" Binding="{Binding Priority}" Width="Auto" MinWidth="80"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Threshold}" Binding="{Binding PhishThresholdLevel}" Width="Auto" MinWidth="80"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.AuthFail}" Binding="{Binding AuthenticationFailAction}" Width="Auto" MinWidth="220"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedAntiPhishPolicy}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InputLabel007" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel007}" Text="{Binding MailSecurity.SelectedAntiPhishPolicy.Name}" IsReadOnly="True"/>
                                <CheckBox Content="{loc:Loc Key=MailSecurity.RuleEnabled}"
                                          IsChecked="{Binding MailSecurity.AntiPhishRuleEnabled}"
                                          Margin="0,12,0,0"
                                          IsEnabled="{Binding MailSecurity.SelectedAntiPhishHasRule}"/>
                                <CheckBox Content="{loc:Loc Key=MailSecurity.EnableSpoofIntelligence}"
                                          IsChecked="{Binding MailSecurity.AntiPhishEnableSpoofIntelligence}"
                                          Margin="0,8,0,0"/>
                                <CheckBox Content="{loc:Loc Key=MailSecurity.EnableMailboxIntelligence}"
                                          IsChecked="{Binding MailSecurity.AntiPhishEnableMailboxIntelligence}"
                                          Margin="0,4,0,0"/>
                                <CheckBox Content="{loc:Loc Key=MailSecurity.EnableTargetedUserProtection}"
                                          IsChecked="{Binding MailSecurity.AntiPhishEnableTargetedUserProtection}"
                                          Margin="0,4,0,0"/>
                                <CheckBox Content="{loc:Loc Key=MailSecurity.HonorDMARCPolicy}"
                                          IsChecked="{Binding MailSecurity.AntiPhishHonorDmarcPolicy}"
                                          Margin="0,4,0,0"/>
                                <TextBlock x:Name="InputLabel008" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.PhishThresholdLevel}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel008}" Text="{Binding MailSecurity.AntiPhishThresholdLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock x:Name="InputLabel009" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.MailboxIntelligenceAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel009}" ItemsSource="{Binding MailSecurity.AntiPhishActions}"
                                          Text="{Binding MailSecurity.AntiPhishMailboxIntelligenceProtectionAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                                <TextBlock x:Name="InputLabel010" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.TargetedUserAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel010}" ItemsSource="{Binding MailSecurity.AntiPhishActions}"
                                          Text="{Binding MailSecurity.AntiPhishTargetedUserProtectionAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                                <TextBlock x:Name="InputLabel011" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.AuthenticationFailAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel011}" ItemsSource="{Binding MailSecurity.AntiPhishActions}"
                                          Text="{Binding MailSecurity.AntiPhishAuthenticationFailAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                                <TextBlock x:Name="InputLabel012" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.DMARCRejectAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel012}" ItemsSource="{Binding MailSecurity.AntiPhishActions}"
                                          Text="{Binding MailSecurity.AntiPhishDmarcRejectAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                                <TextBlock x:Name="InputLabel013" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.DMARCQuarantineAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel013}" ItemsSource="{Binding MailSecurity.AntiPhishActions}"
                                          Text="{Binding MailSecurity.AntiPhishDmarcQuarantineAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                                <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveAntiPhishPolicy}"
                                        Command="{Binding MailSecurity.SaveAntiPhishCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc Key=MailSecurity.AntiMalware}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding MailSecurity.MalwarePolicies}"
                                  SelectedItem="{Binding MailSecurity.SelectedMalwarePolicy}"
                                  AutoGenerateColumns="False"
                                  MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Policy}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.RuleState}" Binding="{Binding RuleState}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Priority}" Binding="{Binding Priority}" Width="Auto" MinWidth="80"/>
                                <DataGridCheckBoxColumn Header="{loc:Loc Key=MailSecurity.FileFilter}" Binding="{Binding EnableFileFilter}" Width="Auto" MinWidth="90"/>
                                <DataGridCheckBoxColumn Header="{loc:Loc Key=MailSecurity.ZAP}" Binding="{Binding ZapEnabled}" Width="Auto" MinWidth="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedAntiMalwarePolicy}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputLabel014" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel014}" Text="{Binding MailSecurity.SelectedMalwarePolicy.Name}" IsReadOnly="True"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.RuleEnabled}"
                                      IsChecked="{Binding MailSecurity.MalwareRuleEnabled}"
                                      Margin="0,12,0,0"
                                      IsEnabled="{Binding MailSecurity.SelectedMalwareHasRule}"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.EnableFileFilter}"
                                      IsChecked="{Binding MailSecurity.MalwareEnableFileFilter}"
                                      Margin="0,8,0,0"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.EnableZAP}"
                                      IsChecked="{Binding MailSecurity.MalwareZapEnabled}"
                                      Margin="0,4,0,0"/>
                            <TextBlock x:Name="InputLabel015" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.FileTypeAction}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel015}" ItemsSource="{Binding MailSecurity.MalwareFileTypeActions}"
                                      Text="{Binding MailSecurity.MalwareFileTypeAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveAntiMalwarePolicy}"
                                    Command="{Binding MailSecurity.SaveMalwareCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Key=MailSecurity.Quarantine}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding MailSecurity.QuarantinePolicies}"
                                  SelectedItem="{Binding MailSecurity.SelectedQuarantinePolicy}"
                                  AutoGenerateColumns="False"
                                  MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Policy}" Binding="{Binding Name}" Width="Auto" MinWidth="200"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Permissions}" Binding="{Binding EndUserQuarantinePermissionsValue}" Width="Auto" MinWidth="150"/>
                                <DataGridCheckBoxColumn Header="{loc:Loc Key=MailSecurity.ESN}" Binding="{Binding EsnEnabled}" Width="Auto" MinWidth="70"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Retention}" Binding="{Binding QuarantineRetentionDays}" Width="Auto" MinWidth="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedQuarantinePolicy}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputLabel016" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel016}" Text="{Binding MailSecurity.SelectedQuarantinePolicy.Name}" IsReadOnly="True"/>
                            <TextBlock x:Name="InputLabel017" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.EndUserPermissions}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel017}" ItemsSource="{Binding MailSecurity.QuarantinePermissions}"
                                      Text="{Binding MailSecurity.QuarantinePermissionsValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.EnableEndUserSpamNotifications}"
                                      IsChecked="{Binding MailSecurity.QuarantineEsnEnabled}"
                                      Margin="0,12,0,0"/>
                            <TextBlock x:Name="InputLabel018" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.NotificationFrequencyDays}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel018}" Text="{Binding MailSecurity.QuarantineEndUserSpamNotificationFrequency, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="InputLabel019" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.RetentionDays}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel019}" Text="{Binding MailSecurity.QuarantineRetentionDays, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="{loc:Loc Key=MailSecurity.OrganizationBrandingEnabled}"
                                      IsChecked="{Binding MailSecurity.QuarantineOrganizationBrandingEnabled}"
                                      Margin="0,12,0,0"/>
                            <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveQuarantinePolicy}"
                                    Command="{Binding MailSecurity.SaveQuarantineCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:Loc Key=MailSecurity.OutboundSpam}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding MailSecurity.OutboundSpamPolicies}"
                                  SelectedItem="{Binding MailSecurity.SelectedOutboundSpamPolicy}"
                                  AutoGenerateColumns="False"
                                  MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Policy}" Binding="{Binding Name}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.ExtH}" Binding="{Binding RecipientLimitExternalPerHour}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.IntH}" Binding="{Binding RecipientLimitInternalPerHour}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Day}" Binding="{Binding RecipientLimitPerDay}" Width="Auto" MinWidth="90"/>
                                <DataGridTextColumn Header="{loc:Loc Key=MailSecurity.Action}" Binding="{Binding ActionWhenThresholdReached}" Width="Auto" MinWidth="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{loc:Loc Key=MailSecurity.SelectedOutboundSpamPolicy}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="InputLabel020" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.Name}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel020}" Text="{Binding MailSecurity.SelectedOutboundSpamPolicy.Name}" IsReadOnly="True"/>
                            <TextBlock x:Name="InputLabel021" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.RecipientLimitExternalHour}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel021}" Text="{Binding MailSecurity.OutboundRecipientLimitExternalPerHour, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="InputLabel022" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.RecipientLimitInternalHour}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel022}" Text="{Binding MailSecurity.OutboundRecipientLimitInternalPerHour, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="InputLabel023" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.RecipientLimitPerDay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel023}" Text="{Binding MailSecurity.OutboundRecipientLimitPerDay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock x:Name="InputLabel024" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.ActionWhenThresholdReached}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel024}" ItemsSource="{Binding MailSecurity.OutboundThresholdActions}"
                                      Text="{Binding MailSecurity.OutboundActionWhenThresholdReached, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <TextBlock x:Name="InputLabel025" Margin="0,12,0,0" Text="{loc:Loc Key=MailSecurity.AutoForwardingMode}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=InputLabel025}" ItemsSource="{Binding MailSecurity.AutoForwardingModes}"
                                      Text="{Binding MailSecurity.OutboundAutoForwardingMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                            <Button ToolTip="{loc:Loc Key=MailSecurity.Requirements}" Content="{loc:Loc Key=MailSecurity.SaveOutboundSpamPolicy}"
                                    Command="{Binding MailSecurity.SaveOutboundSpamCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.RowSpan="3"
                    Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                    Visibility="{Binding MailSecurity.IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MailSecurity.LoadingOverlayText}"
                                   Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                        <ProgressBar IsIndeterminate="True"
                                     Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>

