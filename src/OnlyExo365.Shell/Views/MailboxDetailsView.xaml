<UserControl x:Class="OnlyExo365.Shell.Views.MailboxDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:OnlyExo365.Shell.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OnlyExo365.Shell.Views">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{loc:Loc Key=Btn.BackToMailboxList}" Command="{Binding BackCommand}"
                    Style="{StaticResource {x:Type Button}}" Margin="0,0,12,0"
                    ToolTip="{loc:Loc Key=Mailbox.BackTooltip}"/>

            <StackPanel Grid.Column="1" Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding DisplayName, FallbackValue={loc:Loc Key=Mailbox.DetailsFallbackTitle}}"
                               Style="{StaticResource PageTitleTextStyle}" Margin="0"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasPendingMailboxChanges, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Key=Mailbox.PendingChangesLabel}"
                                       Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc Key=Btn.Save}" Command="{Binding SaveMailboxChangesCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    ToolTip="{loc:Loc Key=Mailbox.PendingChangesTooltip}"/>
                            <Button Content="{loc:Loc Key=Btn.Cancel}" Command="{Binding DiscardMailboxChangesCommand}"
                                    Style="{StaticResource InlineActionButton}"
                                    ToolTip="{loc:Loc Key=Mailbox.PendingChangesDiscardTooltip}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PendingActionsCount, StringFormat={loc:Loc Key=Mailbox.PendingPermissionsFormat}}"
                                       Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{loc:Loc Key=Btn.Save}" Command="{Binding SavePermissionsCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                    ToolTip="{loc:Loc Key=Mailbox.PendingPermissionsTooltip}"/>
                            <Button Content="{loc:Loc Key=Btn.Cancel}" Command="{Binding DiscardPermissionsCommand}"
                                    Style="{StaticResource InlineActionButton}"
                                    ToolTip="{loc:Loc Key=Mailbox.PendingPermissionsDiscardTooltip}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PrimarySmtpAddress}"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>

            <Button Grid.Column="2" Content="{loc:Loc Key=Btn.Refresh}" Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="{loc:Loc Key=Mailbox.RefreshTooltip}"/>
        </Grid>

        <Grid Grid.Row="1"
              IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ErrorBannerBorderStyle}" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Mailbox.ErrorTitle}" Style="{StaticResource ErrorBannerTextStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource StatusBannerMessageTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,32,0,16"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="{loc:Loc Key=Mailbox.LoadingTitle}" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <TabControl Grid.Row="2"
                        Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="{loc:Loc Key=Tab.MailboxOverview}">
                    <views:MailboxOverviewTab/>
                </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.MailboxSettings}">
                    <views:MailboxSettingsTab/>
                </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.MailboxLicenses}">
                    <views:MailboxLicensesTab/>
                </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.MailboxRestore}">
                    <views:MailboxRestoreTab/>
                </TabItem>
                <TabItem Header="{loc:Loc Key=Tab.MailboxPermissions}">
                    <views:MailboxPermissionsTab/>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Mailbox.LoadingOverlayTitle}"
                               Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                    <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource LoadingOverlayBackdropBorderStyle}"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CompactLoadingOverlayCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Mailbox.SavingOverlayTitle}"
                               Style="{StaticResource CompactLoadingOverlayStatusTextStyle}"/>
                    <ProgressBar Style="{StaticResource CompactLoadingOverlayProgressBarStyle}"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

